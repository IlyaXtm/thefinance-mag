{
  "name": "thefinance-mag",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @thefinance/mag-web",
    "dev": "npm run dev --workspace @thefinance/mag-web",
    "wp:seed": "docker compose run --rm wordpress-cli eval-file /var/www/html/wp-content/mu-plugins/thefinance-mag/fixtures/seed.php",
    "wp:verify": "./scripts/verify-content-contract.sh",
    "lint": "npm run lint --workspace @thefinance/mag-web",
    "typecheck": "npm run typecheck --workspace @thefinance/mag-web"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
