# Copy to `.env` next to compose.yaml on the frontend server.
#
# These are SERVER-ONLY names. The `NEXT_PUBLIC_` variants still work as a
# fallback, but nothing that reads these ships to the browser, so the public
# prefix only invites the value into a client bundle later.

# false = real WPGraphQL. Set true only to debug the UI without the CMS.
USE_MOCK=false

# The CMS host. Never appears in a canonical, a sitemap or any rendered page —
# it is only ever fetched from, server-side.
WP_GRAPHQL_ENDPOINT=https://wp.thefinance.ir/mag/graphql

# The PUBLIC origin, and the same value in staging as in production.
#
# Canonicals, og:url, the sitemap and JSON-LD are all built from it, and they
# must name the production URL even when staging is what served the page.
# Pointing this at the staging host would put staging URLs into the index,
# competing with the real ones.
SITE_ORIGIN=https://thefinance.ir

# Shared secret with WordPress, for Preview and revalidation.
#
# SERVER-ONLY — never NEXT_PUBLIC_, or it is inlined into the client bundle and
# anyone viewing source can enable draft mode and read unpublished articles.
#
# Must be byte-identical to TF_MAG_PREVIEW_SECRET in wp-config.php on the CMS.
# The names differ by design: WP_PREVIEW_SECRET here, TF_MAG_PREVIEW_SECRET there.
# (TF_MAG_PREVIEW_SECRET is also accepted here, as a fallback.)
# In wp-config.php rather than the database so it never appears in a dump.
#
#   openssl rand -hex 32
#
# Leave empty and Preview simply does not work — /mag/api/draft answers 401 and
# the article page serves published content. /mag/health reports
# previewConfigured:false so the misconfiguration is visible rather than silent.
WP_PREVIEW_SECRET=
