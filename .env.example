# Copy this file to .env for local development. Never commit real credentials.
COMPOSE_PROJECT_NAME=thefinance-mag

WORDPRESS_DB_NAME=thefinance_mag
WORDPRESS_DB_USER=thefinance_mag
WORDPRESS_DB_PASSWORD=change-me-local-only
WORDPRESS_DB_ROOT_PASSWORD=change-me-local-root-only

# Server-side URL used by the Next.js container.
WORDPRESS_GRAPHQL_URL=http://wordpress/graphql

# Public media origin. Production remains read-only during migration.
NEXT_PUBLIC_WORDPRESS_MEDIA_ORIGIN=https://thefinance.ir
