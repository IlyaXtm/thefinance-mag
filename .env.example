# Data source. `true` uses the mock; `false` hits WPGraphQL.
NEXT_PUBLIC_USE_MOCK=true

# Mock behaviour — lets loading and error states be exercised without real data.
NEXT_PUBLIC_MOCK_LATENCY_MS=300
NEXT_PUBLIC_MOCK_FAIL=0

# WPGraphQL endpoint (CMS host).
NEXT_PUBLIC_WP_GRAPHQL_ENDPOINT=https://wp.thefinance.ir/mag/graphql

# Public origin. Canonicals and sitemap URLs use this, never the CMS host.
NEXT_PUBLIC_SITE_ORIGIN=https://thefinance.ir
